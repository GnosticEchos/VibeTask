{
  "name": "kanban-rewrite",
  "version": "1.0.0",
  "description": "Kanban board backend rewrite with Better Auth and Socket.IO",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "oxlint src && eslint \"src/**/*.ts\"",
    "lint:fix": "oxlint src --fix && eslint \"src/**/*.ts\" --fix",
    "lint:full": "oxlint . && eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bash prisma/full-restore.sh",
"db:restore": "bash prisma/full-restore.sh",
    "db:purge-agent-keys": "tsx scripts/purge-agent-api-keys-for-user.ts",
    "db:reset-rate-limits": "tsx scripts/reset-rate-limit-config.ts",
    "openapi:sync-fe": "node scripts/sync-openapi-to-frontend.mjs",
    "openapi:validate": "redocly lint src/openapi.json",
    "openapi:validate:strict": "redocly lint src/openapi.json --max-problems=0",
    "openapi:bundle": "redocly bundle src/openapi.json --output dist/openapi.json"
  },
  "prisma": {
    "seed": "bash prisma/full-restore.sh"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.2",
    "@better-auth/prisma-adapter": "^1.6.2",
    "@kreuzberg/tree-sitter-language-pack": "^1.6.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "7.7.0",
    "better-auth": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.8.0",
    "pg": "^8.20.0",
    "pg-listen": "^1.7.0",
    "socket.io": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@redocly/cli": "^2.26.0",
    "@stoplight/spectral-cli": "^6.15.1",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.0",
    "oxlint": "^1.59.0",
    "prisma": "^7.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
