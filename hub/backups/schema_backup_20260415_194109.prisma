}

enum DocType {
  CONSTITUTION
  SPECIFICATION
  BRAINSTORM
  POST_MORTEM
  IMPLEMENTATION_PLAN
  OTHER
}

enum DocLinkRole {
  SPECIFICATION
  IMPLEMENTATION_PLAN
  REFERENCE
  ATTACHMENT
}

enum DelegationMode {
  FULL
  COLUMN_BOUND
}


