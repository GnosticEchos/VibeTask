# Server
PORT=3000
WS_PORT=8080
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/kanban"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long-here!!"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CORS - comma-separated list of allowed origins
DEVELOPMENT_FE_ORIGIN="http://localhost:4000,http://localhost:5173"

# Platform Session JWT (required for agent platform-session enforcement)
# Generate with: openssl rand -hex 32
PLATFORM_SESSION_SECRET="your-hmac-secret-min-32-chars-here"