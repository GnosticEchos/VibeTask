{
  "name": "kanbanana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "stylelint-config-recommended-vue": {
      "stylelint-config-recommended": "16.0.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:ts": "oxlint src && eslint \"src/**/*.{ts,tsx,vue}\"",
    "lint:ts:fix": "oxlint src --fix && eslint \"src/**/*.{ts,tsx,vue}\" --fix",
    "lint": "npm run lint:style && npm run lint:ts",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:unit": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "openapi:sync": "node ../Kanban-rewrite/scripts/sync-openapi-to-frontend.mjs",
    "openapi:check-sync": "node scripts/check-openapi-sync.mjs",
    "openapi:gen-types": "node scripts/generate-openapi-types.mjs"
  },
  "dependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/vue-query": "^5.97.0",
    "@vueuse/core": "^12.8.2",
    "autoprefixer": "^10.5.0",
    "axios": "^1.15.0",
    "color": "^5.0.0",
    "daisyui": "^5.0.43",
    "data-grid-vue": "^3.3.1",
    "flowbite-vue": "^0.2.3",
    "happy-dom": "^20.8.3",
    "lodash.debounce": "^4.0.8",
    "markdown-it": "^14.1.1",
    "md-editor-v3": "^6.4.2",
    "mermaid": "^11.4.1",
    "native-event-vue": "^1.4.1",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.3",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-draggable-plus": "^0.6.0",
    "vue-grid-layout-v3": "^3.1.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "caniuse-lite": "^1.0.30001787",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.59.0",
    "sass": "^1.99.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vue-i18n": "^11.3.2",
    "vue-tsc": "^3.2.6"
  }
}
