VITE_API_BASE_URL=http://localhost:3000
# Socket.IO base URL (HTTP origin, not raw ws:// URL)
VITE_WS_BASE_URL=http://localhost:8080
# Optional websocket debug logs in browser console (default: off)
# VITE_WS_DEBUG=true
# Optional: same value as backend RATE_LIMIT_ADMIN_BYPASS_KEY when RATE_LIMIT_ADMIN_BYPASS=true — sends X-Admin-Bypass-Key on /api/admin/* so you can recover from 429 while editing limits (dev / trusted machines only; VITE_ exposes this to the browser).
# VITE_RATE_LIMIT_ADMIN_BYPASS_KEY=