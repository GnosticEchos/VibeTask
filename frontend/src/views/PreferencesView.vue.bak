<script setup lang="ts">
import ThemeSelector from '../components/preferences/ThemeSelector.vue'
import LocaleSelector from '../components/preferences/LocaleSelector.vue'
import { useLayoutStore } from '../stores/layout'
import { computed, ref, reactive } from 'vue'
import { useI18n } from 'vue-i18n'
import { useThemeStore } from '../stores/themeStore'
import { updatePrimaryPalette, updateSurfacePalette, updatePreset } from '@primeuix/themes'
// PrimeVue components for showcase
import Card from 'primevue/card'
import Panel from 'primevue/panel'
import Button from 'primevue/button'
import InputText from 'primevue/inputtext'
import Dropdown from 'primevue/dropdown'
import Checkbox from 'primevue/checkbox'
import RadioButton from 'primevue/radiobutton'
import Tag from 'primevue/tag'
import ProgressSpinner from 'primevue/progressspinner'
import TabView from 'primevue/tabview'
import TabPanel from 'primevue/tabpanel'
import ScrollPanel from 'primevue/scrollpanel'
import ColorPicker from 'primevue/colorpicker'
import Tooltip from 'primevue/tooltip'
import Select from 'primevue/select'

const layoutStore = useLayoutStore()
const fullSideBar = computed(() => layoutStore.sidebarSize === 'large')

const dropdownOptions = ref([
  { label: 'Option 1', value: 1 },
  { label: 'Option 2', value: 2 }
])
const checkboxValue = ref(false)
const radioValue = ref('A')

const themeStore = useThemeStore()

const themeButtons = [
  { label: 'Aura', value: 'Aura' },
  { label: 'Material', value: 'Material' },
  { label: 'Lara', value: 'Lara' },
  { label: 'Nora', value: 'Nora' },
  { label: 'Noir', value: 'Noir' },
]

const colorPickerToken = ref('primary')
const customColor = ref('')

const defaultTokenKeys = [
  'primary', 'secondary', 'background', 'surface', 'text', 'textSecondary', 'border', 'error', 'success', 'warning'
]
const lightColumnColors = reactive({
  primary: '#4CAF50',
  secondary: '#2196F3',
  background: '#FFFFFF',
  surface: '#F5F5F5',
  text: '#000000',
  textSecondary: '#666666',
  border: '#E0E0E0',
  error: '#F44336',
  success: '#4CAF50',
  warning: '#FFC107'
})
const darkColumnColors = reactive({
  primary: '#66BB6A',
  secondary: '#42A5F5',
  background: '#121212',
  surface: '#1E1E1E',
  text: '#FFFFFF',
  textSecondary: '#B0B0B0',
  border: '#333333',
  error: '#EF5350',
  success: '#66BB6A',
  warning: '#FFCA28'
})

function ensureHex(color) {
  if (!color) return '#000000';
  if (typeof color === 'string' && color[0] !== '#') return `#${color}`;
  return color;
}

function selectTheme(base) {
  themeStore.setThemeName(base)
  // Optionally update PrimeVue runtime theme here if needed
}

function selectPalette(palette) {
  const mappingOrder = defaultTokenKeys
  const sanitizedColors = palette.colors.map(ensureHex)
  const target = editMode.value === 'light' ? lightColumnColors : darkColumnColors
  mappingOrder.forEach((token, idx) => {
    target[token] = sanitizedColors[idx] || sanitizedColors[sanitizedColors.length - 1] || '#888888'
  })
}

function resetTheme() {
  // Reset to default theme and color
  themeStore.setThemeName('Aura')
  themeStore.setPrimaryColor('#4CAF50')
  updatePrimaryPalette({ 500: '#4CAF50' })
}

function setCustomColor(color) {
  const sanitized = ensureHex(color)
  customColor.value = sanitized
  if (colorPickerToken.value === 'primary') {
    updatePrimaryPalette({ 500: sanitized })
    themeStore.setPrimaryColor(sanitized)
  } else if (colorPickerToken.value === 'surface') {
    updateSurfacePalette({ 500: sanitized })
    // Optionally add to themeStore if you want to persist surface color
  } else if (colorPickerToken.value === 'noir') {
    // Noir is not a standard token, but you could use updatePreset if needed
    // updatePreset({ semantic: { noir: { 500: sanitized } } })
  }
}

const tokenTooltips = {
  primary: 'Primary: The main accent color used for buttons, highlights, and key UI elements.',
  surface: 'Surface: The background color for cards, panels, and surfaces.',
  noir: 'Noir: A custom token for dark/contrast elements (if supported by your theme).'
}

const themeTokens = [
  { key: 'primary', label: 'Primary' },
  { key: 'secondary', label: 'Secondary' },
  { key: 'background', label: 'Background' },
  { key: 'surface', label: 'Surface' },
  { key: 'text', label: 'Text' },
  { key: 'textSecondary', label: 'Text Secondary' },
  { key: 'border', label: 'Border' },
  { key: 'error', label: 'Error' },
  { key: 'success', label: 'Success' },
  { key: 'warning', label: 'Warning' },
]
const editMode = ref<'light' | 'dark'>('light')
const lightTheme = computed(() => themeStore.availableThemes.find(t => !t.isDark) || themeStore.currentTheme)
const darkTheme = computed(() => themeStore.availableThemes.find(t => t.isDark) || themeStore.currentTheme)

function applyLocalTheme() {
  const mappingOrder = [
    'primary', 'secondary', 'background', 'surface', 'text', 'textSecondary', 'border', 'error', 'success', 'warning'
  ];
  const colorScheme = editMode.value === 'light' ? 'light' : 'dark';
  const source = editMode.value === 'light' ? lightColumnColors : darkColumnColors;
  // Create a new theme object based on the current light or dark theme
  let baseTheme = editMode.value === 'light' ? lightTheme.value : darkTheme.value;
  const newTheme = {
    ...baseTheme,
    colors: { ...baseTheme.colors }
  };
  mappingOrder.forEach((token) => {
    newTheme.colors[token] = source[token];
  });
  themeStore.setTheme(newTheme);
  // Optionally persist changes if needed (handled by setTheme)
  console.log('[Apply] Applied local theme to', colorScheme, JSON.stringify(source, null, 2));
}

// Tailwind color families and stops
const tailwindColors = [
  { name: 'Blue', key: 'blue', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Indigo', key: 'indigo', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Emerald', key: 'emerald', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Rose', key: 'rose', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Gray', key: 'gray', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Red', key: 'red', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Yellow', key: 'yellow', stops: [50,100,200,300,400,500,600,700,800,900] },
  { name: 'Green', key: 'green', stops: [50,100,200,300,400,500,600,700,800,900] },
];

const tailwindHex = {
  blue:   {50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8',800:'#1e40af',900:'#1e3a8a'},
  indigo: {50:'#eef2ff',100:'#e0e7ff',200:'#c7d2fe',300:'#a5b4fc',400:'#818cf8',500:'#6366f1',600:'#4f46e5',700:'#4338ca',800:'#3730a3',900:'#312e81'},
  emerald:{50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',300:'#6ee7b7',400:'#34d399',500:'#10b981',600:'#059669',700:'#047857',800:'#065f46',900:'#064e3b'},
  rose:   {50:'#fff1f2',100:'#ffe4e6',200:'#fecdd3',300:'#fda4af',400:'#fb7185',500:'#f43f5e',600:'#e11d48',700:'#be123c',800:'#9f1239',900:'#881337'},
  gray:   {50:'#f9fafb',100:'#f3f4f6',200:'#e5e7eb',300:'#d1d5db',400:'#9ca3af',500:'#6b7280',600:'#4b5563',700:'#374151',800:'#1f2937',900:'#111827'},
  red:    {50:'#fef2f2',100:'#fee2e2',200:'#fecaca',300:'#fca5a5',400:'#f87171',500:'#ef4444',600:'#dc2626',700:'#b91c1c',800:'#991b1b',900:'#7f1d1d'},
  yellow: {50:'#fefce8',100:'#fef9c3',200:'#fef08a',300:'#fde047',400:'#facc15',500:'#eab308',600:'#ca8a04',700:'#a16207',800:'#854d0e',900:'#713f12'},
  green:  {50:'#f0fdf4',100:'#dcfce7',200:'#bbf7d0',300:'#86efac',400:'#4ade80',500:'#22c55e',600:'#16a34a',700:'#15803d',800:'#166534',900:'#14532d'},
};

const semanticRoles = [
  { key: 'primary', label: 'Primary' },
  { key: 'surface', label: 'Surface' },
  { key: 'background', label: 'Background' },
  { key: 'text', label: 'Text' },
  { key: 'textSecondary', label: 'Text Secondary' },
  { key: 'border', label: 'Border' },
  { key: 'error', label: 'Error' },
  { key: 'success', label: 'Success' },
  { key: 'warning', label: 'Warning' },
];

const mode = ref('light'); // 'light' or 'dark'
const selectedRole = ref('primary');

const defaultPalettes = {
  'Tailwind Blue': {
    light: {
      primary: { family: 'blue', stop: 500 },
      surface: { family: 'gray', stop: 50 },
      background: { family: 'gray', stop: 100 },
      text: { family: 'gray', stop: 900 },
      textSecondary: { family: 'gray', stop: 500 },
      border: { family: 'gray', stop: 200 },
      error: { family: 'red', stop: 500 },
      success: { family: 'green', stop: 500 },
      warning: { family: 'yellow', stop: 500 },
    },
    dark: {
      primary: { family: 'blue', stop: 400 },
      surface: { family: 'gray', stop: 900 },
      background: { family: 'gray', stop: 800 },
      text: { family: 'gray', stop: 50 },
      textSecondary: { family: 'gray', stop: 400 },
      border: { family: 'gray', stop: 700 },
      error: { family: 'red', stop: 400 },
      success: { family: 'green', stop: 400 },
      warning: { family: 'yellow', stop: 400 },
    }
  },
  'Material Indigo': {
    light: {
      primary: { family: 'indigo', stop: 500 },
      surface: { family: 'gray', stop: 50 },
      background: { family: 'gray', stop: 100 },
      text: { family: 'gray', stop: 900 },
      textSecondary: { family: 'gray', stop: 500 },
      border: { family: 'gray', stop: 200 },
      error: { family: 'red', stop: 500 },
      success: { family: 'green', stop: 500 },
      warning: { family: 'yellow', stop: 500 },
    },
    dark: {
      primary: { family: 'indigo', stop: 400 },
      surface: { family: 'gray', stop: 900 },
      background: { family: 'gray', stop: 800 },
      text: { family: 'gray', stop: 50 },
      textSecondary: { family: 'gray', stop: 400 },
      border: { family: 'gray', stop: 700 },
      error: { family: 'red', stop: 400 },
      success: { family: 'green', stop: 400 },
      warning: { family: 'yellow', stop: 400 },
    }
  },
  'Custom': {
    light: {},
    dark: {}
  }
};

const presetNames = Object.keys(defaultPalettes);
const selectedPreset = ref('Tailwind Blue');

const selectedColors = reactive({
  light: { ...defaultPalettes['Tailwind Blue'].light },
  dark: { ...defaultPalettes['Tailwind Blue'].dark }
});

function selectColor(role, family, stop) {
  selectedColors[mode.value][role] = { family, stop };
}

function getHex(family, stop) {
  return tailwindHex[family]?.[stop] || '#000';
}

function applyTheme() {
  const root = document.documentElement;
  for (const role of semanticRoles) {
    const { family, stop } = selectedColors[mode.value][role.key];
    root.style.setProperty(`--color-${role.key}`, getHex(family, stop));
  }
}

function selectPreset(preset) {
  selectedPreset.value = preset;
  // Fill palette for current mode
  Object.assign(selectedColors.light, defaultPalettes[preset].light);
  Object.assign(selectedColors.dark, defaultPalettes[preset].dark);
}

function toggleMode(newMode) {
  mode.value = newMode;
}

const currentColors = computed(() => selectedColors[mode.value]);

function applyPreset(preset) {
  selectedPreset.value = preset;
  const presetPalette = defaultPalettes[preset];
  if (!presetPalette) return;
  // Apply all semantic roles for both light and dark
  for (const mode of ['light', 'dark']) {
    for (const role of semanticRoles) {
      if (presetPalette[mode] && presetPalette[mode][role.key]) {
        selectedColors[mode][role.key] = { ...presetPalette[mode][role.key] };
      }
    }
  }
}
</script>

<template>
  <TabView>
    <TabPanel :header="$t('preferences.generalSettings')">
      <div class="input-section">
        <span class="label">{{ $t('preferences.language') }}</span>
        <LocaleSelector :flagsOnly="!fullSideBar" />
      </div>
    </TabPanel>
    <TabPanel :header="$t('preferences.manageProjects')">
      <div class="input-section">
        <span class="label">{{ $t('preferences.projectUserManagement') }}</span>
        <div class="placeholder">{{ $t('preferences.comingSoon') }}</div>
      </div>
    </TabPanel>
    <TabPanel :header="$t('preferences.themePlayground')">
      <div class="theme-playground-panel flex flex-col gap-4">
        <!-- Top Controls Row: Presets, Edit Mode, Semantic Role Selector -->
        <div class="flex flex-row gap-4 items-center mb-0">
          <div>
            <label class="block font-semibold mb-1">Presets</label>
            <div class="flex gap-2">
              <button v-for="preset in presetNames" :key="preset" class="px-3 py-1 rounded border" :class="{ 'bg-blue-100 border-blue-500': selectedPreset === preset }" @click="applyPreset(preset)">{{ preset }}</button>
            </div>
          </div>
          <div class="ml-8">
            <label class="block font-semibold mb-1">Edit Mode</label>
            <div class="flex gap-2">
              <button :class="{ 'bg-blue-600 text-white': mode === 'light' }" class="px-3 py-1 rounded border" @click="toggleMode('light')">Edit Light</button>
              <button :class="{ 'bg-blue-600 text-white': mode === 'dark' }" class="px-3 py-1 rounded border" @click="toggleMode('dark')">Edit Dark</button>
            </div>
          </div>
          <div class="ml-8">
            <label for="role-select" class="block font-semibold mb-1">Select Semantic Role</label>
            <select id="role-select" v-model="selectedRole" class="border rounded px-2 py-1">
              <option v-for="role in semanticRoles" :key="role.key" :value="role.key">{{ role.label }}</option>
            </select>
          </div>
        </div>
        <!-- Main Content Row: Theme Card (left) + Color Selector (right) -->
        <div class="flex flex-row w-full gap-6 items-start mt-0">
          <!-- Left: Theme Card (33%) -->
          <div class="flex flex-col w-1/3 min-w-[420px] max-w-[520px]">
            <div class="theme-summary-card-2col bg-white dark:bg-gray-800 border rounded-lg shadow p-3 flex flex-col">
              <div class="text-xl font-bold mb-2">Theme Card</div>
              <div class="flex flex-row items-start w-full">
                <!-- Light Column -->
                <div class="flex-1 pr-3">
                  <div class="summary-col-title font-semibold mb-2">Light</div>
                  <div v-for="role in semanticRoles" :key="role.key" class="summary-token-row flex items-center gap-1 mb-1">
                    <span class="token-label min-w-[90px] text-xs">{{ role.label }}</span>
                    <span class="token-swatch w-6 h-6 rounded border" :style="{ background: getHex(selectedColors.light[role.key]?.family, selectedColors.light[role.key]?.stop) }"></span>
                    <span class="token-value font-mono text-xs">{{ getHex(selectedColors.light[role.key]?.family, selectedColors.light[role.key]?.stop) }}</span>
                  </div>
                </div>
                <!-- Divider -->
                <div class="w-px bg-gray-300 mx-2 self-stretch"></div>
                <!-- Dark Column -->
                <div class="flex-1 pl-3">
                  <div class="summary-col-title font-semibold mb-2">Dark</div>
                  <div v-for="role in semanticRoles" :key="role.key" class="summary-token-row flex items-center gap-1 mb-1">
                    <span class="token-label min-w-[90px] text-xs">{{ role.label }}</span>
                    <span class="token-swatch w-6 h-6 rounded border" :style="{ background: getHex(selectedColors.dark[role.key]?.family, selectedColors.dark[role.key]?.stop) }"></span>
                    <span class="token-value font-mono text-xs">{{ getHex(selectedColors.dark[role.key]?.family, selectedColors.dark[role.key]?.stop) }}</span>
                  </div>
                </div>
              </div>
              <button class="apply-btn px-3 py-1 rounded bg-blue-600 text-white font-semibold mt-4 self-end" @click="applyTheme">Apply</button>
            </div>
          </div>
          <!-- Right: Color Selector (67%) -->
          <div class="flex flex-col w-2/3 min-w-[320px] justify-start">
            <div class="scrollable-color-selector flex flex-wrap gap-1 py-1 items-start">
              <div v-for="color in tailwindColors" :key="color.key" class="color-family-panel min-w-[90px]">
                <div class="font-semibold mb-1 text-xs">{{ color.name }}</div>
                <div class="flex flex-col space-y-1">
                  <button
                    v-for="stop in color.stops"
                    :key="stop"
                    class="w-12 h-6 rounded shadow border border-gray-200"
                    :style="{ backgroundColor: getHex(color.key, stop), border: currentColors[selectedRole].family === color.key && currentColors[selectedRole].stop === stop ? '2px solid #000' : '' }"
                    @click="selectColor(selectedRole, color.key, stop)"
                  >
                    <span class="text-xs">{{ stop }}</span>
                  </button>
                </div>
              </div>
            </div>
            <div class="mt-2 flex flex-wrap gap-2">
              <div v-for="role in semanticRoles" :key="role.key" class="flex items-center gap-1">
                <span class="font-semibold text-xs">{{ role.label }}:</span>
                <span class="w-6 h-6 rounded border" :style="{ backgroundColor: getHex(currentColors[role.key]?.family, currentColors[role.key]?.stop) }"></span>
                <span class="font-mono text-xs">{{ getHex(currentColors[role.key]?.family, currentColors[role.key]?.stop) }}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6 p-6 rounded shadow border" style="background: var(--color-surface); color: var(--color-text);">
          <div class="text-2xl font-bold mb-2">Live Theme Preview</div>
          <div class="mb-2">This area uses your selected theme variables:</div>
          <div class="flex gap-4">
            <div class="p-4 rounded" style="background: var(--color-primary); color: var(--color-text);">Primary Area</div>
            <div class="p-4 rounded" style="background: var(--color-surface); color: var(--color-text);">Surface Area</div>
            <div class="p-4 rounded" style="background: var(--color-background); color: var(--color-text);">Background Area</div>
            <div class="p-4 rounded" style="background: var(--color-error); color: var(--color-text);">Error</div>
            <div class="p-4 rounded" style="background: var(--color-success); color: var(--color-text);">Success</div>
            <div class="p-4 rounded" style="background: var(--color-warning); color: var(--color-text);">Warning</div>
          </div>
        </div>
      </div>
    </TabPanel>
  </TabView>
</template>

