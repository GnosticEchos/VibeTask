// Color Palette
$primary: (
  'lighten': #dfdcff,
  'base': #6560ba,
  'base-opacity': #6560ba5c,
  'darken1': #5554a0,
  'darken2': #474479
);
$grayscale: (
  'base': #e2e3e8,
  'lighten1': #7e828e,
  'darken1': #70727f,
  'darken2': #3a3a46,
  'darken3': #2c2c38,
  'darken3-opacity': #2c2c3871,
  'darken4': #21212d,
  'darken5': #2f2f3b,
  'darken6': #292938,
  'darken7': #23232f
);
$field: (
  'hover-darken': #2424307c
);
$base-colors: (
  '1': #4ec4df,
  '2': #836ff2,
  '3': #8bdbc0,
  '4': #ff7a00,
  '5': #ed0000
);
$status: (
  'success': #52ba28,
  'warning': #ff7a00,
  'error': #ed0000,
  'error-darken': #6b1a2b
);
$palettes: (
  "primary": $primary,
  "grayscale": $grayscale,
  "field": $field,
  "base-colors": $base-colors,
  "status": $status
);
