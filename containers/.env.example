# Ports + domain — edit these, then run ./scripts/setup.sh
VT_DOMAIN=vibetask.local
RPXY_HTTP_PORT=11780
RPXY_HTTPS_PORT=11743
HUB_HTTP_PORT=11700
HUB_WS_PORT=11701
FRONTEND_PORT=11740
POSTGRES_PORT=11732

# Optional: publish hub API to host for CLI debugging (HTTP, no TLS)
HUB_PUBLISH_TO_HOST=false

# Optional — only for compose.rpxy-local.yaml (your rust-rpxy build)
# RPXY_BUILD_CONTEXT=$HOME/src/rust-rpxy
# RPXY_BINARY=$HOME/src/rust-rpxy/target/release/rpxy

# Derived by setup.sh — do not edit manually
# PUBLIC_URL=https://vibetask.local:11743
# VITE_API_BASE_URL=...
# VITE_WS_BASE_URL=...
# BETTER_AUTH_URL=...
# DEVELOPMENT_FE_ORIGIN=...
# VIBETASK_HUB_URL=...

# Secrets — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32-min-32-chars
PLATFORM_SESSION_SECRET=change-me-use-openssl-rand-hex-32-min-32-chars
POSTGRES_USER=vibetask
POSTGRES_PASSWORD=vibetask
POSTGRES_DB=kanban
DATABASE_URL=postgresql://vibetask:vibetask@postgres:5432/kanban
